---
import Base from "../layouts/Base.astro";
---

<Base title="404 — Not Found" lang="en">
  <main
    class="mx-auto flex max-w-5xl flex-col items-center px-4 py-32 text-center"
  >
    <h1 class="mb-4 text-6xl font-bold">404</h1>
    <p class="mb-8 text-slate-400">Page not found</p>
    <a
      href="/ru/"
      class="rounded-lg bg-indigo-500 px-5 py-2.5 transition hover:bg-indigo-400"
    >
      На главную
    </a>
  </main>
</Base>
